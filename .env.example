# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key"

# Trigger.dev
TRIGGER_SECRET_KEY="tr_dev_your_secret_key"
TRIGGER_PROJECT_REF="your-trigger-project-ref"

DRAWGLE_GEMINI_ROUTER_MODEL="gemini-3.1-flash-lite"
DRAWGLE_GEMINI_FULL_BUILD_MODEL="gemini-3-flash-preview"
DRAWGLE_GEMINI_SELECTED_EDIT_MODEL="gemini-3.1-flash-lite"
DRAWGLE_GEMINI_PROJECT_PLANNER_MODEL="gemini-3-flash-preview"
DRAWGLE_GEMINI_REFERENCE_ANALYSIS_MODEL="gemini-3-flash-preview"

# OpenRouter screen builds
OPENROUTER_API_KEY="sk-or-v1_your_key"
DRAWGLE_SCREEN_BUILDER_PROVIDER="gemini"
DRAWGLE_SCREEN_BUILDER_MODEL="gemini-3-flash-preview"
DRAWGLE_OPENROUTER_SCREEN_BUILD_MODEL="moonshotai/kimi-k2.5"
DRAWGLE_OPENROUTER_FALLBACK_MODELS="qwen/qwen3.6-plus,moonshotai/kimi-k2.5"
DRAWGLE_OPENROUTER_MAX_TOKENS="32000"
DRAWGLE_OPENROUTER_HEADER_TIMEOUT_MS="15000"
DRAWGLE_OPENROUTER_FIRST_TOKEN_TIMEOUT_MS="45000"
DRAWGLE_OPENROUTER_IDLE_TIMEOUT_MS="45000"
DRAWGLE_OPENROUTER_HARD_TIMEOUT_MS="240000"
DRAWGLE_OPENROUTER_SORT=""
DRAWGLE_OPENROUTER_ALLOW_FALLBACKS="true"
DRAWGLE_OPENROUTER_PROVIDERS=""
# Sent as `reasoning: { effort: "medium", exclude: true }` for OpenRouter screen builds.
# Supported effort values: minimal, low, medium, high, xhigh, max. Set effort to "none" to disable.
DRAWGLE_OPENROUTER_SCREEN_BUILD_REASONING_EFFORT="medium"
DRAWGLE_OPENROUTER_SCREEN_BUILD_REASONING_EXCLUDE="true"
# Sent as `reasoning: { effort: "low", exclude: true }` for OpenRouter selected-region edits.
DRAWGLE_OPENROUTER_SCREEN_EDITOR_REASONING_EFFORT="low"
DRAWGLE_OPENROUTER_SCREEN_EDITOR_REASONING_EXCLUDE="true"

# Visual assets
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="drawgle-assets"
R2_PUBLIC_BASE_URL="https://assets.your-domain.com"
CURATED_ASSET_IMPORT_SECRET="change_me"
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# DodoPayments Configuration
DODO_PAYMENTS_API_KEY="xyz_1234567890abcdef"
DODO_PAYMENTS_WEBHOOK_SECRET="abcsecret123456"
DODO_ENVIRONMENT="test_mode"
